# ─────────────────────────────────────────────────────────────
# Скопируй в .env и заполни своими данными:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Bybit ────────────────────────────────────────────────────
# https://www.bybit.com/app/user/api-management
# Создавай ключи с правами: Read + Trade (БЕЗ Withdraw!)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ── Hyperliquid ──────────────────────────────────────────────
# https://app.hyperliquid.xyz/API
# Используй subaccount с ограниченным капиталом
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ADDRESS=
HYPERLIQUID_TESTNET=false

# ── Telegram ─────────────────────────────────────────────────
# Создай бота через @BotFather, получи токен
# Узнай свой chat_id через @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Стратегия ────────────────────────────────────────────────
# paper  — симуляция без реальных ордеров (СТАРТ ОТСЮДА!)
# testnet — реальные ордера на тестовой бирже
# live   — реальные деньги (только после 2+ недель paper trading)
MODE=paper

CAPITAL_USD=1000
MIN_FUNDING_DIFF_PCT=0.03
MAX_POSITIONS=3
MAX_POSITION_PCT=30
STOP_LOSS_PCT=2
DAILY_DRAWDOWN_LIMIT_PCT=5

# ── Сканирование ─────────────────────────────────────────────
SCAN_INTERVAL_SEC=60
MIN_VOLUME_24H_USD=1000000

# ── Database ─────────────────────────────────────────────────
DB_PATH=funding_arb.db

# ── Логи ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
