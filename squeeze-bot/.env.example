# ── Биржа ────────────────────────────────────────────────────
# Bybit: Read + Trade (БЕЗ Withdraw!)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Стратегия ────────────────────────────────────────────────
# paper  — симуляция (СТАРТ ОТСЮДА)
# live   — реальные деньги
MODE=paper

CAPITAL_USD=500                  # Отдельный капитал для squeeze бота
POSITION_SIZE_USD=100            # Размер одной позиции
MAX_POSITIONS=2                  # Макс одновременных позиций

# Порог входа: funding rate за 8h должен быть больше этого значения
MIN_FUNDING_ABS_PCT=0.3          # 0.3% минимум

# Входить за сколько секунд до выплаты
ENTRY_BEFORE_FUNDING_SEC=45

# Stop Loss и Take Profit в % от цены входа
STOP_LOSS_PCT=0.5
TAKE_PROFIT_PCT=0.8

# Принудительное закрытие если SL/TP не сработали за N секунд
MAX_POSITION_AGE_SEC=300         # 5 минут

# ── Сканирование ─────────────────────────────────────────────
SCAN_INTERVAL_SEC=10             # Проверяем каждые 10 секунд

# ── DB / Логи ────────────────────────────────────────────────
DB_PATH=squeeze.db
LOG_LEVEL=INFO
